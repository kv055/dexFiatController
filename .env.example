# TOTP API Service
TOTP_API_KEY=
TOTP_SECRETS=

# Browser
HEADLESS=true
CHROME_PATH=/usr/bin/chromium-browser

# OpenAI (for Stagehand self-healing)
OPENAI_API_KEY=

# PayPal
PAYPAL_EMAIL=
PAYPAL_PASSWORD=
PAYPAL_TOTP_SECRET=

# Wise
WISE_EMAIL=
WISE_PASSWORD=
WISE_TOTP_SECRET=
WISE_PHONE=

# Revolut
REVOLUT_EMAIL=
REVOLUT_PASSWORD=
REVOLUT_PHONE=

# SMS Provider (Twilio or similar)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=

# Email Provider (for Revolut email 2FA)
EMAIL_PROVIDER=imap
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Controller
POLL_INTERVAL=30s
LOG_LEVEL=info
