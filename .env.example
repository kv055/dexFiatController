# Shared Postgres runtime role for dexFiatController
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_fiat_controller
POSTGRES_PASSWORD=dex_fiat_controller
DATABASE_URL=postgres://dex_fiat_controller:dex_fiat_controller@localhost:5432/dexarb?sslmode=disable

# TOTP API Service
TOTP_API_KEY=

# Browser
HEADLESS=true
CHROME_PATH=/usr/bin/chromium-browser

# OpenAI (for Stagehand self-healing)
OPENAI_API_KEY=

# SMS Provider (Twilio or similar)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=

# Email Provider (for Revolut email 2FA)
EMAIL_PROVIDER=imap
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Controller
POLL_INTERVAL=30s
LOG_LEVEL=info
