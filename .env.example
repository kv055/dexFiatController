# Postgres connection for local/standalone runs
# Standalone URL (required by scripts/validate-env-contract.sh). Under
# docker-compose the service builds the URL from POSTGRES_HOST/PORT/DB/USER/
# PASSWORD, so set those instead of editing this URL for the dockerised stack.
DATABASE_URL=postgres://dex_fiat_controller:dex_fiat_controller@localhost:5432/dexarb?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_fiat_controller
POSTGRES_PASSWORD=dex_fiat_controller

# TOTP API Service
TOTP_API_KEY=
# Optional dev seed for the totp-api service (name=secret pairs, comma-separated).
# TOTP_SECRETS=
# Base URL of the totp-api helper (compose default http://totp-api:8080).
TOTP_API_URL=http://totp-api:8080

# Standalone totp-api helper (services/totp-api, not part of the compose stack).
# PORT=8080
# API_KEY=

# Standalone capture-shape probe (cmd/captureserver, dev only).
# CAPTURE_ADDR=:8088
# CAPTURE_DIR=./capture-data
# CAPTURE_FILE=capture.jsonl

# Browser
HEADLESS=true
CHROME_PATH=/usr/bin/chromium-browser

# OpenAI (for Stagehand self-healing)
OPENAI_API_KEY=

# SMS Provider (Twilio or similar)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_PHONE_NUMBER=

# Email Provider (for Revolut email 2FA)
EMAIL_PROVIDER=imap
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Incoming Wise/PayPal payment notifications (separate from email 2FA above).
# Use capture -> shadow -> active. Active requires both watermarks so captured
# mail can never be replayed into a release.
PAYMENT_EMAIL_MODE=capture
PAYMENT_EMAIL_IMAP_HOST=maddy
PAYMENT_EMAIL_IMAP_PORT=993
PAYMENT_EMAIL_IMAP_USER=payments@example.com
PAYMENT_EMAIL_IMAP_PASS=
PAYMENT_EMAIL_IMAP_MAILBOX=INBOX
PAYMENT_EMAIL_TLS_SERVER_NAME=mx.example.com
PAYMENT_EMAIL_TLS_CA_FILE=/maddy-tls/fullchain.pem
PAYMENT_EMAIL_POLL_INTERVAL=5m
PAYMENT_EMAIL_HEALTH_MAX_AGE=15m
PAYMENT_EMAIL_RECONNECT_MIN=2s
PAYMENT_EMAIL_RECONNECT_MAX=1m
PAYMENT_EMAIL_ACTIVATION_UID=0
PAYMENT_EMAIL_ACTIVATION_TIME=

# Controller
POLL_INTERVAL=30s
LOG_LEVEL=info

# Scraping is the last-resort fiat-arrival path. Disabled by default; pushpush below is
# the primary path. Set to true only when a connector has no push notification feed.
SCRAPING_ENABLED=false

# pushpush: push-based fiat-arrival server (primary). Receives payment notifications,
# matches them to pending transactions, and triggers BTC release on dexTakerController.
PUSHPUSH_ADDR=:8080
PUSHPUSH_NOTIFY_SECRET=
# Dedicated secret for POST/GET /phone-heartbeat. Falls back to PUSHPUSH_NOTIFY_SECRET.
PUSHPUSH_HEARTBEAT_SECRET=
# Phone is reported offline after this time without a heartbeat.
PUSHPUSH_HEARTBEAT_MAX_AGE=15m
PUSHPUSH_DATA_DIR=/data
# dexTakerController dex-release webhook (bearer-token auth).
PUSHPUSH_DEX_RELEASE_URL=http://dexmmcontroller:8080/api/webhooks/dex-release
PUSHPUSH_DEX_RELEASE_TOKEN=
PUSHPUSH_RELEASE_TIMEOUT=10s
# Telegram escalation for ambiguous/unclassified notifications. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUSHPUSH_TELEGRAM_WEBHOOK_URL=
# Shared secret for fiat-arrival payment notifications sent to unified-api.
# Injected from the ROOT .env under docker-compose.
PAYMENT_NOTIFICATIONS_SHARED_SECRET=
# Capture-only mode without a database (or forced). Set true to run the
# pushpush receiver without matching/releasing (safe ingest testing).
PUSHPUSH_CAPTURE_ONLY=false
